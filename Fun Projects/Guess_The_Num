import random

number = random.randint(1, 100)

print("I'm thinking of a number between 1 and 100!")

tries = 1

guess = int(input("Guess the number: "))

while guess != number:
    tries+=1
    if guess < number:
        print("Go higher!")
    else:
        print("Go lower!")

    guess = int(input("Guess again: "))


print("You got it! 🎉")
print(f"It took you {tries} tries to get it right!")